-- [ MODULE 2: VECTOR TELEPORTATION MATRIX ]
-- =================================================================
local TPTab = Window:Tab({ Title = "Teleport", Icon = "solar:map-point-bold" })

local function GetPlayerNames()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then table.insert(list, p.Name) end
    end
    return list
end

TPTab:Section({ Title = "Target Acquisition" })

local PlayerDropdown = TPTab:Dropdown({
    Title = "Select Target Profile",
    Multi = false,
    Values = GetPlayerNames(),
    Value = nil,
    Callback = function(v) tpTargetName = v end
})

TPTab:Button({
    Title = "Refresh Directory",
    Icon = "solar:refresh-bold",
    Callback = function()
        PlayerDropdown:Refresh(GetPlayerNames())
        WindUI:Notify({ Title = "Teleportation", Content = "Active player directory updated successfully." })
    end
})

TPTab:Button({
    Title = "Execute Relocation",
    Icon = "solar:rocket-bold",
    Callback = function()
        if tpTargetName ~= "" then
            local targetPlr = Players:FindFirstChild(tpTargetName)
            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                local myChar = lp.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    myChar.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0)
                    WindUI:Notify({ Title = "Teleportation", Content = "Successfully relocated to: " .. targetPlr.Name })
                end
            end
        else
            WindUI:Notify({ Title = "Execution Error", Content = "No valid target profile selected." })
        end
    end
})

