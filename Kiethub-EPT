-- [ Thuật toán Kéo Thả (Draggable) mượt mà tối ưu cho cả Cảm ứng & Chuột ]
local dragging, dragInput, dragStart, startPos
ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- [ Logic Kích Hoạt Ẩn/Hiện Toàn Bộ UI ]
local WindUIScreenGui = nil
ToggleBtn.MouseButton1Click:Connect(function()
    if not WindUIScreenGui or not WindUIScreenGui.Parent then
        -- Quét tìm ScreenGui gốc của hệ thống WindUI để can thiệp trạng thái
        for _, gui in ipairs(CoreGui:GetChildren()) do
            if gui:IsA("ScreenGui") and (gui.Name:match("Wind") or gui:FindFirstChild("Main")) then
                WindUIScreenGui = gui; break
            end
        end
        if not WindUIScreenGui then
            for _, gui in ipairs(lp:WaitForChild("PlayerGui"):GetChildren()) do
                if gui:IsA("ScreenGui") and (gui.Name:match("Wind") or gui:FindFirstChild("Main")) then
                    WindUIScreenGui = gui; break
                end
            end
        end
    end
    
    if WindUIScreenGui then
        WindUIScreenGui.Enabled = not WindUIScreenGui.Enabled
    else
        -- Cơ chế khẩn cấp nếu Executor không cấp quyền can thiệp tầng sâu
        pcall(function() Window:Toggle() end)
    end
end)

