-- [ MODULE 5: VISUAL RECONNAISSANCE (ESP) ]
-- =================================================================
local VisualsTab = Window:Tab({ Title = "Visuals", Icon = "solar:eye-bold" })

local function CreateESP(plr)
    task.spawn(function()
        while plr.Parent and ESP_Enabled do
            task.wait(0.5)
            if plr.Character and plr ~= lp then
                if not plr.Character:FindFirstChild("IY_ESP") then
                    local h = Instance.new("Highlight", plr.Character)
                    h.Name = "IY_ESP"
                    h.FillColor = Color3.fromRGB(255, 0, 0)
                    h.FillTransparency = 0.5
                end
                if ESP_Names and not plr.Character.Head:FindFirstChild("IY_Name") then
                    local b = Instance.new("BillboardGui", plr.Character.Head)
                    b.Name = "IY_Name"; b.AlwaysOnTop = true; b.Size = UDim2.new(0, 100, 0, 50)
                    local l = Instance.new("TextLabel", b)
                    l.Text = plr.Name; l.Size = UDim2.new(1, 0, 1, 0); l.BackgroundTransparency = 1; l.TextColor3 = Color3.new(1, 1, 1)
                end
            end
        end
    end)
end

